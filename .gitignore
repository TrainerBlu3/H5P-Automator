# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Playwright / setup marker
.playwright_installed

# App data (sessions, credentials, downloads) — never lives in the repo,
# but ignore anyway in case a local run drops files here
downloads/
userdata/
session.json
config.json
*.session.json

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Node (in case any tooling adds it)
node_modules/

# PyInstaller local build output (CI builds these fresh; see release.yml)
build/
dist/
*.spec

# Generated at CI build time (see main-latest.yml / release.yml) — stamps
# the packaged build with the commit SHA it was built from, for the
# in-app update checker. Absent in source checkouts, which disables it.
gui/_build_info.py
